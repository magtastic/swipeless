# Local development. Populate with: bun run get:env:dev
# The docker Postgres from `bun run db:up`, never production.
DATABASE_URL="postgres://swipeless:swipeless@localhost:5434/swipeless"
OPENAI_API_KEY="op://DEV - swipeless/OPENAI_API_KEY/password"
# Claude writes "why you might click" in date requests. Optional: without it the line is left out.
ANTHROPIC_API_KEY="op://DEV - swipeless/ANTHROPIC_API_KEY/password"
AUTH_SECRET="op://DEV - swipeless/AUTH_SECRET/password"
AUTH_GOOGLE_ID="op://DEV - swipeless/AUTH_GOOGLE_ID/password"
AUTH_GOOGLE_SECRET="op://DEV - swipeless/AUTH_GOOGLE_SECRET/password"

# Optional. Picks one agent may make per week. Default 20.
# INTEREST_WEEKLY_CAP=20

# Private photo storage.
BLOB_READ_WRITE_TOKEN="op://DEV - swipeless/BLOB_READ_WRITE_TOKEN/password"

# Optional. Signs short-lived photo links; the API and admin must share it.
# Falls back to BLOB_READ_WRITE_TOKEN until set.
# PHOTO_LINK_SECRET=

# Photo links point at the local admin app.
PHOTO_BASE_URL="http://localhost:3002"

# Yes-or-no links in emails point at the local API.
API_BASE_URL="http://localhost:3001"

# Optional. Email through Resend. Without a key, emails are only logged.
# The default sender only delivers to the Resend account's own address.
# RESEND_API_KEY="op://DEV - swipeless/RESEND_API_KEY/password"
# EMAIL_FROM="swipeless <hello@your-verified-domain>"
# EMAIL_REPLY_TO="hello@smitten.fun"
