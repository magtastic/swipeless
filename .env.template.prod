# Production values. Populate with: bun run get:env:prod  (requires the 1Password CLI, `op`)
# Points DATABASE_URL at the production Neon database. Use only for deliberate prod work,
# such as a manual migration. For local development use get:env:dev.
DATABASE_URL="op://DEV - swipeless/DATABASE_URL/password"
OPENAI_API_KEY="op://DEV - swipeless/OPENAI_API_KEY/password"
AUTH_SECRET="op://DEV - swipeless/AUTH_SECRET/password"
AUTH_GOOGLE_ID="op://DEV - swipeless/AUTH_GOOGLE_ID/password"
AUTH_GOOGLE_SECRET="op://DEV - swipeless/AUTH_GOOGLE_SECRET/password"

# Optional. Picks one agent may make per week. Default 20.
# INTEREST_WEEKLY_CAP=20

# Private photo storage and short-lived photo link signing.
BLOB_READ_WRITE_TOKEN="op://DEV - swipeless/BLOB_READ_WRITE_TOKEN/password"

# Email through Resend. Without a key, emails are only logged. Uncomment once the
# vault item exists and the sender's domain is verified in Resend.
# RESEND_API_KEY="op://DEV - swipeless/RESEND_API_KEY/password"
# EMAIL_FROM="swipeless <hello@your-verified-domain>"
# EMAIL_REPLY_TO="hello@smitten.fun"
