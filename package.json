{
  "name": "swipeless",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.5.13",
      "@effect/ai": "0.37.0",
      "@effect/ai-openai": "0.41.0",
      "@effect/experimental": "0.61.1",
      "@effect/platform": "0.97.2",
      "@effect/platform-bun": "0.91.2",
      "@effect/rpc": "0.76.2",
      "@effect/sql": "0.52.1",
      "@effect/sql-drizzle": "0.51.0",
      "@effect/sql-pg": "0.53.0",
      "@tailwindcss/postcss": "4.3.3",
      "@types/bun": "1.4.2",
      "@types/node": "22.20.2",
      "@types/pg": "8.23.1",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "drizzle-kit": "0.31.10",
      "drizzle-orm": "0.45.2",
      "effect": "3.22.2",
      "next": "16.3.4",
      "pg": "8.23.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2"
    }
  },
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "verify": "bun run typecheck && bun run lint && bun run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "test:db": "TEST_DATABASE_URL=postgres://swipeless:swipeless@localhost:5434/swipeless bun test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "get:env:dev": "op inject -f -i .env.template.dev -o .env",
    "get:env:prod": "op inject -f -i .env.template.prod -o .env"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
